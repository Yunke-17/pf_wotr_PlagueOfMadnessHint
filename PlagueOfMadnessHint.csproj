<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="packages\AssemblyPublicizer.1.0.2\build\AssemblyPublicizer.props" Condition="Exists('packages\AssemblyPublicizer.1.0.2\build\AssemblyPublicizer.props')" />
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7E5F2C41-9C3B-4B27-9F6A-1D8E4A0B5C31}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PlagueOfMadnessHint</RootNamespace>
    <AssemblyName>PlagueOfMadnessHint</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>

    <!-- 游戏目录（绝对路径，避免依赖工程所在层级） -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Pathfinder Second Adventure</GameDir>
    <GameManagedDir>$(GameDir)\Wrath_Data\Managed</GameManagedDir>
    <PublicizedAssembliesDir>$(MSBuildProjectDirectory)\publicized_assemblies</PublicizedAssembliesDir>
    <!-- 编译产物自动拷贝到游戏的 Mods 目录，文件夹名用 UMM 的 Id -->
    <ActualModTargetDir>$(GameDir)\Mods\PlagueOfMadnessHint</ActualModTargetDir>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <!--
      .NET SDK 的 Copy 任务默认会用「硬链接」来把 obj 下的 dll 复制到 bin，
      在本机（沙箱 / 特殊文件系统）创建硬链接会阻塞，导致 dotnet build 卡死在
      CopyFilesToOutputDirectory 目标。这里统一关闭硬链接优化，改用普通文件复制。
    -->
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>false</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
    <CreateHardLinksForCopyLocalIfPossible>false</CreateHardLinksForCopyLocalIfPossible>
    <CreateHardLinksForPublishFilesIfPossible>false</CreateHardLinksForPublishFilesIfPossible>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameManagedDir)\UnityModManager\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(PublicizedAssembliesDir)\Assembly-CSharp_public.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(GameManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- 需要公共化的游戏程序集（原始程序集） -->
    <PublicizeAssembly Include="$(GameManagedDir)\Assembly-CSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core\BlueprintPatcher.cs" />
    <Compile Include="Core\GameRefs.cs" />
    <Compile Include="Core\Main.cs" />
    <Compile Include="Core\ReadyNotifier.cs" />
    <Compile Include="Core\StrictConsecutivePatch.cs" />
    <Compile Include="Managers\LocalizationManager.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Settings\ReadyCatalog.cs" />
    <Compile Include="Settings\Settings.cs" />
    <Compile Include="Settings\SettingsGUI.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <ItemGroup>
    <ModLocalizationFiles Include="$(ProjectDir)Localization\en.json" />
    <ModLocalizationFiles Include="$(ProjectDir)Localization\zh-CN.json" />
  </ItemGroup>
  <!--
    编译前自动公共化 Assembly-CSharp：Mod 需要访问非公开成员
    （AbilityUsagesCountTrigger.Data / .Fact、BlueprintBuff 的私有成员等）。
    产物为 publicized_assemblies\Assembly-CSharp_public.dll（注意 _public 后缀）。
  -->
  <Target Name="PublicizeGameAssemblies" BeforeTargets="ResolveAssemblyReferences"
          Inputs="@(PublicizeAssembly)"
          Outputs="$(PublicizedAssembliesDir)\Assembly-CSharp_public.dll">
    <Message Text="[PlagueOfMadnessHint] 公共化游戏程序集 -> $(PublicizedAssembliesDir)" Importance="high" />
    <MakeDir Directories="$(PublicizedAssembliesDir)" />
    <AssemblyPublicizer.PublicizeTask InputAssemblies="@(PublicizeAssembly)"
                                      OutputDir="$(PublicizedAssembliesDir)"
                                      PublicizeExplicitImpls="false" />
  </Target>
  <!--
    编译后自动部署到游戏 Mods 目录。
    若构建环境无法写入游戏目录（例如权限受限 / 沙箱拦截，会让 MSBuild 的 Copy 任务卡死），
    可用 -p:SkipModDeploy=true 跳过自动部署，只产出 bin\Release 下的 dll，之后手动拷贝。
  -->
  <Target Name="PostBuildCopyFiles" AfterTargets="PostBuildEvent" Condition="'$(SkipModDeploy)' != 'true'">
    <MakeDir Directories="$(ActualModTargetDir)" Condition="!Exists('$(ActualModTargetDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ActualModTargetDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)Info.json" DestinationFolder="$(ActualModTargetDir)" SkipUnchangedFiles="false" />
    <MakeDir Directories="$(ActualModTargetDir)\Localization" Condition="!Exists('$(ActualModTargetDir)\Localization')" />
    <Copy SourceFiles="@(ModLocalizationFiles)" DestinationFolder="$(ActualModTargetDir)\Localization" SkipUnchangedFiles="false" />
    <Message Text="[PlagueOfMadnessHint] 已拷贝到 $(ActualModTargetDir)" Importance="high" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>缺少 NuGet 包 AssemblyPublicizer。缺少的文件是 {0}。</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\AssemblyPublicizer.1.0.2\build\AssemblyPublicizer.props')" Text="$([System.String]::Format('$(ErrorText)', 'packages\AssemblyPublicizer.1.0.2\build\AssemblyPublicizer.props'))" />
  </Target>
</Project>
